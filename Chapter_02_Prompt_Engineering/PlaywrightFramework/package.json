{
  "name": "wingify-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript UI tests for the Wingify login and SSO flows",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=chromium",
    "test:valid": "playwright test tests/login-valid.spec.ts --project=chromium",
    "test:invalid": "playwright test tests/login-invalid.spec.ts --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "allure:generate": "allure generate allure-results --clean --output allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.3"
  }
}
